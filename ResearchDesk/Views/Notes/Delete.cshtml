@model ResearchDesk.Models.Note
@{
    ViewData["Title"] = "Delete Note";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="container mt-4">
    <h2>Delete Note</h2>
    <p class="text-danger" Are you sure you want to delete this?</p>

    <div class="card">
        <div class="card-body">
            <p><strong>Content:</strong> @Model.Content</p>
            <p><strong>Created:</strong> @Model.CreatedAt.ToShortDateString()</p>
        </div>
    </div>

    <form method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@returnUrl" />

        <button type="submit" class="btn btn-danger">Delete</button>
        @if (!string.IsNullOrEmpty(returnUrl))
        {
            <a href="@returnUrl" class="btn btn-secondary">Cancel</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        }
    </form>
</div>