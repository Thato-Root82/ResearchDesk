@model ResearchDesk.Models.AISource

@{
    ViewData["Title"] = "Delete AI Log";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="container mt-4">
    <h2>🗑️ Delete AI Log</h2>

    <p class="text-danger">Are you sure you want to delete this?</p>

    <div class="card">
        <div class="card-body">
            <p><strong>Tool:</strong> @Model.ToolName</p>
            <p><strong>Question:</strong> @Model.QuestionAsked</p>
            <p><strong>Date:</strong> @Model.DateUsed.ToShortDateString()</p>
        </div>
    </div>

    <form method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit" class="btn btn-danger">Delete</button>

        @if (!string.IsNullOrEmpty(returnUrl))
        {
            <a href="@returnUrl" class="btn btn-secondary">Cancel</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        }
    </form>
</div>