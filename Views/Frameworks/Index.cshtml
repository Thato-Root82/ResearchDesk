@model List<ResearchDesk.Models.Framework>
@{
    ViewData["Title"] = "Frameworks";
    var returnUrl = Url.Action("Index", "Frameworks");
}

<h2><span class="emoji">🏛️</span> Policy Frameworks</h2>

@if (TempData["msg"] != null)
{
    <div class="alert alert-success">@TempData["msg"]</div>
}

<a asp-action="Create" asp-route-returnUrl="@returnUrl" class="btn btn-primary mb-3">
    <span class="emoji">➕</span> Add Framework
</a>

@if (Model.Any())
{
    <div class="row">
        @foreach (var framework in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title"><span class="emoji">🏗️</span> @framework.Name</h5>
                        <p class="card-text">@framework.Description</p>
                        <p class="small text-muted"><span class="emoji">📋</span> @framework.SourceCitation</p>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <span></span>
                        <span>
                            <a asp-action="Edit" asp-route-id="@framework.Id" asp-route-returnUrl="@returnUrl" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@framework.Id" asp-route-returnUrl="@returnUrl" class="btn btn-sm btn-danger">Delete</a>
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted text-center"><span class="emoji">🏛️</span> No frameworks yet. Add one!</p>
}

<a asp-action="Index" asp-controller="Dashboard" class="btn btn-secondary mt-3">
    <span class="emoji">←</span> Back to Dashboard
</a>
