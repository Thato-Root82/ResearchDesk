@model ResearchDesk.Models.Assignment
@{
    ViewData["Title"] = "Create Assignment";
}

<h2>Create New Assignment</h2>

<form asp-action="Create">
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder="e.g. Assignment 01 – Social Welfare Policy Analysis" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DueDate" class="form-label"></label>
        <input asp-for="DueDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="UniqueNumber" class="form-label">Unique Number</label>
        <input asp-for="UniqueNumber" class="form-control" placeholder="e.g. 87857" />
    </div>

    <div class="mb-3">
        <label asp-for="TotalMarks" class="form-label"></label>
        <input asp-for="TotalMarks" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="EssayPrompt" class="form-label"></label>
        <textarea asp-for="EssayPrompt" class="form-control" rows="5" placeholder="Paste the essay prompt here..."></textarea>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="IsCompleted" type="checkbox" class="form-check-input" />
        <label asp-for="IsCompleted" class="form-check-label">Completed</label>
    </div>

    <button type="submit" class="btn btn-success">Save Assignment</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>