@model ResearchDesk.Models.Note
@{
    ViewData["Title"] = "Add Note";
    var returnUrl = ViewBag.ReturnUrl as string;
    var assignments = ViewBag.Assignments as List<ResearchDesk.Models.Assignment>;
}
<div class="container mt-4">
    <h2><span class="emoji">➕</span> Add New Note</h2>
    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@returnUrl" />

        <div class="mb-3">
            <label class="form-label">Assignment</label>
            <select asp-for="AssignmentId" class="form-control" required>
                <option value="">-- Select an assignment --</option>
                @if (assignments != null)
                {
                    foreach (var a in assignments)
                    {
                        <option value="@a.Id" selected="@(a.Id == Model.AssignmentId)">@a.Title</option>
                    }
                }
            </select>
            <span asp-validation-for="AssignmentId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Content</label>
            <textarea asp-for="Content" class="form-control" rows="6" required></textarea>
        </div>

        <button type="submit" class="btn btn-success"><span class="emoji">💾</span> Save</button>
        @if (!string.IsNullOrEmpty(returnUrl))
        {
            <a href="@returnUrl" class="btn btn-secondary">Cancel</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        }
    </form>
</div>